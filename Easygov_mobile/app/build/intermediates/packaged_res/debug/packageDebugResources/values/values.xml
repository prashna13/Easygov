<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_dark">#1A1C1E</color>
    <color name="background_light">#F8F9FA</color>
    <color name="black">#FF000000</color>
    <color name="onBackground_dark">#E2E2E6</color>
    <color name="onBackground_light">#1A1C1E</color>
