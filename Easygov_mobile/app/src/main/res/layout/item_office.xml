<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivOfficeIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_category_tag"
            android:contentDescription="@string/service_icon"
            android:padding="10dp"
            android:src="@drawable/ic_documents" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfficeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Kathmandu District Administration Office" />

            <TextView
                android:id="@+id/tvOfficeType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="District Administration Office (DAO)" />

            <TextView
                android:id="@+id/tvOfficeAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Tripureshwor, Kathmandu" />

            <TextView
                android:id="@+id/tvOfficeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Kathmandu · 01-4211650" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOfficeDirections"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:text="@string/office_directions"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            app:backgroundTint="@color/primary_light"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconGravity="textStart"
            app:iconTint="@color/onPrimary_light"
            android:textColor="@color/onPrimary_light" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOfficeDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/primary_light"
        tools:text="2.4 km away" />
</LinearLayout>