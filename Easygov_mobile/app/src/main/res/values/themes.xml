<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Easygov" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color Palette -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorOnPrimary">@color/onPrimary_light</item>
        <item name="colorPrimaryContainer">@color/primaryContainer_light</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer_light</item>
        <item name="colorPrimaryInverse">@color/primary_dark</item>

        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/onSecondary_light</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer_light</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer_light</item>
        <item name="colorTertiary">@color/secondary_light</item>
        <item name="colorTertiaryContainer">@color/secondaryContainer_light</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/onBackground_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/onSurface_light</item>
        <item name="colorSurfaceContainer">@color/surfaceContainer_light</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainer_light</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant_light</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_light</item>
        <item name="colorError">@color/danger_light</item>
        <item name="colorErrorContainer">@color/dangerContainer_light</item>
        <item name="colorOnErrorContainer">@color/onDangerContainer_light</item>

        <!-- Window / system bars -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Easygov.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Easygov.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Easygov.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Easygov.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Easygov.LabelLarge</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Easygov.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Easygov.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Easygov.LargeComponent</item>

        <!-- Component Specific Styles -->
        <item name="materialCardViewStyle">@style/Widget.Easygov.Card</item>
        <item name="materialButtonStyle">@style/Widget.Easygov.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.Easygov.NavigationBar</item>
    </style>

    <style name="Theme.Easygov" parent="Base.Theme.Easygov" />

    <!-- Cards: pure white, 16dp radius, soft elevation, no outlines -->
    <style name="Widget.Easygov.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.Easygov.Card</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Easygov.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Easygov.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Easygov.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline_light</item>
    </style>

<!-- Navigation bar (M3 BottomNavigationView) with soft pill active indicator -->
    <style name="Widget.Easygov.NavigationBar" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_light</item>
        <item name="elevation">8dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Easygov.NavigationBar.ActiveIndicator</item>
    </style>

    <style name="Widget.Easygov.NavigationBar.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/chipHighlight_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Easygov.MediumComponent</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Segmented buttons (language switcher) -->
    <style name="Widget.Easygov.SegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline_light</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Easygov.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_light</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    <style name="Widget.Easygov.AssistChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chipHighlight_light</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    <style name="Widget.Easygov.SuggestionChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/surfaceVariant_light</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <!-- Progress -->
    <style name="Widget.Easygov.LinearProgressDeterminate" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/surfaceVariant_light</item>
        <item name="indicatorColor">@color/success_light</item>
        <item name="trackThickness">6dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>
</resources>